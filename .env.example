# ── MySQL ──────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=pcvuser
MYSQL_PASSWORD=pcvpass
MYSQL_DB=pcvconsole
MYSQL_ROOT_PASSWORD=rootpass

# ── MongoDB ────────────────────────────────────
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=pcvmongo
MONGO_PASSWORD=mongopass
MONGO_DB=pcvconsole

# ── JWT ────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ── App ────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true

# ── LLM (optional - leave blank for stub mode) ─
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
